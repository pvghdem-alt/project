rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // DiscussionNote Validation
    function isValidNote(data) {
      return data.keys().hasAll(['floor', 'space', 'content', 'timestamp', 'createdAt', 'status', 'authorId']) &&
             data.floor is string && data.floor.size() <= 128 &&
             data.space is string && data.space.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.timestamp is string && data.timestamp.size() <= 100 &&
             data.status in ['pending', 'confirmed'] &&
             data.authorId is string &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /notes/{noteId} {
      allow list: if true;
      allow get: if true;
      allow create: if isSignedIn() && isValidId(noteId) && isValidNote(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidNote(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['content', 'status', 'updatedAt'])
      ) && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn();
    }

    // CustomTopic Validation
    function isValidTopic(data) {
      return data.keys().hasAll(['name', 'createdAt', 'creatorId', 'floorId', 'order', 'isDefault']) &&
             data.name is string && data.name.size() <= 100 &&
             data.creatorId is string &&
             data.floorId is string &&
             data.order is number &&
             data.isDefault is bool;
    }

    match /topics/{topicId} {
      allow read, list: if true;
      allow create: if isSignedIn() && isValidId(topicId) && isValidTopic(incoming()) && 
                      incoming().get('type', 'space') in ['space', 'trade'] &&
                      incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidTopic(incoming()) && 
                    (
                      incoming().diff(existing()).affectedKeys().hasOnly(['name']) ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['order']) ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'order'])
                    ) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().creatorId == existing().creatorId &&
                    incoming().isDefault == existing().isDefault;
      allow delete: if isSignedIn();
    }

    match /maps/{mapId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /requirements/{reqId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /checklist/{checkId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // SpacePhotos Validation
    function isValidPhoto(data) {
      return data.keys().hasAll(['space', 'url', 'createdAt', 'authorId']) &&
             data.keys().size() >= 4 &&
             data.space is string &&
             data.url is string && data.url.size() < 1000000 && // Under 1MB
             data.authorId is string;
    }

    match /photos/{photoId} {
      allow read, list: if true;
      allow create: if isSignedIn() && isValidPhoto(incoming()) && incoming().createdAt == request.time;
      allow update: if false; // Photos are immutable or only updated by admin
      allow delete: if isSignedIn();
    }
  }
}
